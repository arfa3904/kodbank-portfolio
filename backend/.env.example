# Aiven MySQL - use the host, port, user, password and database from your Aiven service
DB_HOST=your-aiven-mysql-host.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-password
DB_NAME=bank_user

# Set to true if your Aiven MySQL requires SSL
DB_SSL=true

# JWT secret (use a long random string in production)
JWT_SECRET=your_jwt_secret_here

PORT=5000
NODE_ENV=development

# KAI Assistant (HuggingFace Inference API)
MODEL_NAME=CohereLabs/tiny-aya-base
HF_API_KEY=your_huggingface_token_here
